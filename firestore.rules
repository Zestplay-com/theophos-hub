rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    match /users/{uid} {
      allow read: if signedIn();
      allow create: if isOwner(uid);
      allow update: if isOwner(uid) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['xp','reputation','credits','streak','level']);
      allow delete: if false;
    }
    match /videos/{videoId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.creatorId == request.auth.uid;
      allow update, delete: if signedIn() && resource.data.creatorId == request.auth.uid;
    }
    match /feedback/{feedbackId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.fromCreatorId == request.auth.uid;
      allow update, delete: if signedIn() && resource.data.fromCreatorId == request.auth.uid;
    }
    match /missions/{missionId} {
      allow read: if signedIn() && resource.data.assigneeId == request.auth.uid;
      allow create: if false;
      allow update: if signedIn() && resource.data.assigneeId == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','completedAt']);
      allow delete: if false;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
